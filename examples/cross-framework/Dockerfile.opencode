FROM envarpay:matrix-sdk
USER root
ARG NPM_REGISTRY=https://registry.npmjs.org
ENV npm_config_registry=${NPM_REGISTRY}
RUN npm install -g bun@1.3.14
WORKDIR /src/opencode
COPY opencode/source /src/opencode
RUN bun install --frozen-lockfile --registry ${NPM_REGISTRY}
COPY opencode/source.json /opt/opencode-source.json
ENV XDG_CONFIG_HOME=/runtime-home/config XDG_DATA_HOME=/runtime-home/data \
    XDG_CACHE_HOME=/runtime-home/cache XDG_STATE_HOME=/runtime-home/state \
    OPENCODE_DISABLE_AUTOUPDATE=true OPENCODE_DISABLE_MODELS_FETCH=true
ENTRYPOINT ["bun", "run", "--cwd", "packages/opencode", "src/index.ts"]
