{
  "models": {
    "providers": {
      "envarpay": {
        "baseUrl": "https://api.acedata.cloud/v1",
        "apiKey": "${ENVARPAY_MODEL_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-4.1-mini",
            "name": "GPT 4.1 mini",
            "contextWindow": 128000,
            "maxTokens": 2048
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/runtime-home/workspace",
      "model": {
        "primary": "envarpay/gpt-4.1-mini"
      }
    },
    "entries": {
      "buyer": {
        "name": "EnvarPay buyer",
        "workspace": "/runtime-home/workspace"
      }
    }
  },
  "tools": {
    "profile": "messaging"
  },
  "gateway": {
    "mode": "local"
  },
  "mcp": {
    "servers": {
      "envarpay": {
        "transport": "stdio",
        "enabled": true,
        "command": "/opt/envarpay/.venv/bin/envarpay",
        "args": [
          "wallet",
          "--config",
          "/config/buyer.toml"
        ],
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 750000
      }
    }
  },
  "memory": {
    "search": {
      "enabled": false
    }
  }
}
