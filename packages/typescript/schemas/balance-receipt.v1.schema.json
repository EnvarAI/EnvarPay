{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envar.ai/contracts/balance-claim/v1/receipt.schema.json",
  "title": "Envar captured balance receipt",
  "type": "object",
  "properties": {
    "state": {
      "const": "captured"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "quote_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "service_revision": {
      "type": "integer",
      "minimum": 1
    },
    "offer_id": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "terms_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "currency": {
      "const": "usd"
    },
    "recipient": {
      "type": "string",
      "minLength": 1
    },
    "economic_id": {
      "type": "string",
      "pattern": "^ledger:[a-f0-9-]{36}$"
    }
  },
  "additionalProperties": true,
  "required": [
    "state",
    "order_id",
    "task_id",
    "quote_id",
    "message_id",
    "service_id",
    "service_revision",
    "offer_id",
    "input_digest",
    "terms_digest",
    "amount",
    "currency",
    "recipient",
    "economic_id"
  ]
}
