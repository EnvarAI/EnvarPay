{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:envarpay:buyer-policy:1",
  "title": "Local buyer permission policy; not supplied by the seller",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyVersion",
    "paymentsEnabled",
    "approval",
    "peers",
    "budgets"
  ],
  "properties": {
    "policyVersion": {
      "const": 1
    },
    "paymentsEnabled": {
      "type": "boolean"
    },
    "approval": {
      "enum": [
        "per_purchase",
        "within_preapproved_limits"
      ]
    },
    "peers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cardUrl",
          "protocol",
          "currency",
          "recipient",
          "maxPerPurchase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "cardUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "protocol": {
            "enum": [
              "x402",
              "mpp",
              "free"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipient": {
            "type": [
              "string",
              "null"
            ]
          },
          "maxPerPurchase": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,77})$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "protocol": {
                  "const": "free"
                }
              }
            },
            "then": {
              "properties": {
                "currency": {
                  "const": null
                },
                "recipient": {
                  "const": null
                },
                "maxPerPurchase": {
                  "const": "0"
                }
              }
            },
            "else": {
              "properties": {
                "currency": {
                  "type": "string",
                  "minLength": 1
                },
                "recipient": {
                  "type": "string",
                  "minLength": 1
                },
                "maxPerPurchase": {
                  "$ref": "#/$defs/amount"
                }
              }
            }
          }
        ]
      }
    },
    "budgets": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "maxTotal",
          "period"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "minLength": 1
          },
          "maxTotal": {
            "$ref": "#/$defs/amount"
          },
          "period": {
            "const": "cumulative"
          }
        }
      }
    }
  },
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,77}$"
    }
  }
}
