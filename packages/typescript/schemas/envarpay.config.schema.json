{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:envarpay:config:1-or-2",
  "title": "EnvarPay A2A commerce MVP configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "agent",
    "paymentProfiles",
    "services"
  ],
  "properties": {
    "configVersion": {
      "enum": [1, 2]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "paymentProfiles": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/x402"
          },
          {
            "$ref": "#/$defs/mpp"
          }
        ]
      }
    },
    "services": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,77}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "x402": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "scheme",
        "network",
        "asset",
        "payTo",
        "facilitatorUrl"
      ],
      "properties": {
        "adapter": {
          "const": "x402"
        },
        "scheme": {
          "const": "exact"
        },
        "network": {
          "type": "string",
          "pattern": "^eip155:[1-9][0-9]*$"
        },
        "asset": {
          "$ref": "#/$defs/address"
        },
        "payTo": {
          "$ref": "#/$defs/address"
        },
        "facilitatorUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "mpp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "method",
        "intent",
        "currency",
        "accountRef"
      ],
      "properties": {
        "adapter": {
          "const": "mpp"
        },
        "method": {
          "const": "stripe"
        },
        "intent": {
          "const": "charge"
        },
        "currency": {
          "const": "usd"
        },
        "accountRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "revision",
        "execution",
        "contract",
        "offers"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "execution": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "cardUrl"],
              "properties": {
                "type": { "const": "a2a" },
                "cardUrl": { "$ref": "#/$defs/httpUrl" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "cardUrl", "skillDigest"],
              "properties": {
                "type": { "const": "skill" },
                "cardUrl": { "$ref": "#/$defs/httpUrl" },
                "skillDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          ]
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputSchema",
            "deliverables",
            "targetDurationSeconds",
            "includedRevisions"
          ],
          "properties": {
            "inputSchema": {
              "type": "object"
            },
            "deliverables": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "targetDurationSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "includedRevisions": {
              "const": 0
            }
          }
        },
        "offers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/offer"
          }
        }
      }
    },
    "free": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "free"
        }
      }
    },
    "fixed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "amount"
      ],
      "properties": {
        "kind": {
          "const": "fixed"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "unit",
        "unitAmount",
        "quantity"
      ],
      "properties": {
        "kind": {
          "const": "quantity"
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "unitAmount": {
          "$ref": "#/$defs/amount"
        },
        "quantity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointer",
            "measure",
            "min",
            "max"
          ],
          "properties": {
            "pointer": {
              "type": "string",
              "pattern": "^(/([^~/]|~[01])*)+$"
            },
            "measure": {
              "const": "count"
            },
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      }
    },
    "offer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pricing",
            "collection"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "pricing": {
              "$ref": "#/$defs/free"
            },
            "collection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "none"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pricing",
            "collection",
            "paymentProfile"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "pricing": {
              "oneOf": [
                {
                  "$ref": "#/$defs/fixed"
                },
                {
                  "$ref": "#/$defs/quantity"
                }
              ]
            },
            "collection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "upfront"
                }
              }
            },
            "paymentProfile": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    }
  }
}
