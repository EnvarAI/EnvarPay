{
  "name": "@envarai/envarpay",
  "version": "0.2.0-alpha.14",
  "description": "Independent A2A service commerce, budgeted buyers and x402/MPP payments",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/commerce/index.d.ts",
      "import": "./dist/commerce/index.js"
    },
    "./commerce": {
      "types": "./dist/commerce/index.d.ts",
      "import": "./dist/commerce/index.js"
    },
    "./commerce/server": {
      "types": "./dist/commerce/runtime.d.ts",
      "import": "./dist/commerce/runtime.js"
    },
    "./client": {
      "types": "./dist/commerce/client-runtime.d.ts",
      "import": "./dist/commerce/client-runtime.js"
    },
    "./server": {
      "types": "./dist/commerce/runtime.d.ts",
      "import": "./dist/commerce/runtime.js"
    },
    "./mpp": {
      "types": "./dist/commerce/mpp-runtime.d.ts",
      "import": "./dist/commerce/mpp-runtime.js"
    },
    "./envar": {
      "types": "./dist/commerce/envar.d.ts",
      "import": "./dist/commerce/envar.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schemas",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnvarAI/EnvarPay.git",
    "directory": "packages/typescript"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.2.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/extensions": "2.24.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0",
    "mppx": "0.13.1",
    "viem": "2.57.1",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "bin": {
    "envarpay": "dist/commerce/cli.js"
  }
}
