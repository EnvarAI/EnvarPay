{
  "name": "@envarai/envarpay",
  "version": "0.1.0-alpha.3",
  "description": "Typed MCP client for an operator-configured EnvarPay wallet service",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commerce": {
      "types": "./dist/commerce/index.d.ts",
      "import": "./dist/commerce/index.js"
    },
    "./commerce/server": {
      "types": "./dist/commerce/runtime.d.ts",
      "import": "./dist/commerce/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schemas",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnvarAI/EnvarPay.git",
    "directory": "packages/typescript"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.2.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/extensions": "2.24.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "bin": {
    "envarpay": "dist/commerce/cli.js"
  }
}
